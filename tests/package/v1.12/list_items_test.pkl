/// Deleting list items, which Talos supports from 1.12 on.
amends "pkl:test"

import "pkl:test"

import "@talos/ConfigPatch.pkl"
import "@talos/network/NetworkRuleConfig.pkl"
import "@talos/v1alpha1/Config.pkl"

local function render(docs: Listing): String = (ConfigPatch) { documents = docs }.output.text

local function problems(docs: Listing): String = test.catch(() -> render(docs))

facts {
  ["a list item to delete sets exactly one property"] {
    problems(new Listing {
      new NetworkRuleConfig {
        name = "ingress"
        ingress {
          new {
            subnet = "10.0.0.0/8"
            except = "10.0.1.0/24"
            `$patch` = "delete"
          }
        }
      }
    })
      .contains(
        "documents[0] (NetworkRuleConfig \"ingress\").ingress[0]: a list item to delete must set exactly one property, which Talos matches items on, but it sets `subnet`, `except`",
      )
    problems(new Listing {
      new NetworkRuleConfig {
        name = "ingress"
        ingress {
          new {
            `$patch` = "delete"
          }
        }
      }
    }).contains("but it sets none")
  }
}

examples {
  ["list items"] {
    render(new Listing {
      new Config {
        machine {
          logging {
            destinations {
              new {
                endpoint = "udp://127.0.0.1:5000"
                `$patch` = "delete"
              }
            }
          }
        }
      }
      new NetworkRuleConfig {
        name = "ingress"
        ingress {
          new { subnet = "10.0.0.0/8" }
          new {
            subnet = "192.168.0.0/16"
            `$patch` = "delete"
          }
        }
      }
    })
  }
}
