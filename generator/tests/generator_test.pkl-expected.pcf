examples {
  ["document module"] {
    """
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// WidgetConfig configures a widget.
    ///
    /// It has many parts.
    open module talos.example.WidgetConfig
    
    extends "../Document.pkl"
    
    import "../example.pkl"
    import "../patch.pkl"
    
    fixed apiVersion: String = "v1alpha1"
    
    fixed kind: String = "WidgetConfig"
    
    /// Name of the widget.
    name: String
    
    size: (Int(isBetween(1, 10)) | patch.Delete)?
    
    `local`: (Boolean | patch.Delete)?
    
    `tcp-data-split`: (String | patch.Delete)?
    
    parts: (*Listing<example.Part>(length >= 1) | patch.Delete)?
    
    labels: (*Mapping<String, String | patch.Delete> | patch.Delete)?
    
    args: (*Mapping<String, String | Listing<String> | patch.Delete> | patch.Delete)?
    
    ports: (*Listing<Int | String> | patch.Delete)?
    
    /// The widget's certificate and key.
    tls: (*Tls | patch.Delete)?
    
    /// Set to `"delete"` to delete this document from the machine configuration.
    ///
    /// Talos finds the document by its `apiVersion`, `kind` and `name`, so set no other property.
    `$patch`: patch.Directive?
    
    /// The widget's certificate and key.
    class Tls {
      crt: (String | patch.Delete)?
    
      key: (String | patch.Delete)?
    
      /// Set to `"delete"` to delete this object from the machine configuration.
      ///
      /// In a list, Talos deletes the items whose first property has the same value, so set only the
      /// property to match on.
      `$patch`: patch.Directive?
    }
    
    """
  }
  ["document module with free-form data and durations"] {
    """
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// GadgetConfig configures the gadget.
    open module talos.example.GadgetConfig
    
    extends "../Document.pkl"
    
    import "../patch.pkl"
    import "../schema.pkl"
    
    fixed apiVersion: String = "v1alpha1"
    
    fixed kind: String = "GadgetConfig"
    
    /// Whether the gadget runs.
    mode: ("on" | "off" | patch.Delete)?
    
    timeout: (schema.GoDuration | patch.Delete)?
    
    manifest: (*schema.Unstructured | patch.Delete)?
    
    /// Set to `"delete"` to delete this document from the machine configuration.
    ///
    /// Talos finds the document by its `apiVersion`, `kind` and `name`, so set no other property.
    `$patch`: patch.Directive?
    
    """
  }
  ["types module"] {
    #"""
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// Types of the Talos `example` configuration documents.
    module talos.example
    
    import "patch.pkl"
    import "schema.pkl"
    
    /// Part is a part of a widget.
    class Part {
      /// Address of the part.
      @schema.Required
      address: (String(contains(Regex(#"^[0-9a-f.:]+/\d{1,3}$"#))) | patch.Delete)?
    
      priority: (Int | patch.Delete)?
    
      /// Set to `"delete"` to delete this object from the machine configuration.
      ///
      /// In a list, Talos deletes the items whose first property has the same value, so set only the
      /// property to match on.
      `$patch`: patch.Directive?
    }
    
    """#
  }
  ["legacy document"] {
    """
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// Config is the legacy document.
    open module talos.v1alpha1.Config
    
    extends "../Document.pkl"
    
    import "../patch.pkl"
    import "../v1alpha1.pkl"
    
    /// Version of the configuration document format.
    fixed version: String = "v1alpha1"
    
    machine: (*v1alpha1.MachineConfig | patch.Delete)?
    
    """
    """
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// Types of the Talos `v1alpha1` configuration documents.
    module talos.v1alpha1
    
    import "patch.pkl"
    
    class LoggingDestination {
      endpoint: (String | patch.Delete)?
    
      /// Set to `"delete"` to delete this object from the machine configuration.
      ///
      /// In a list, Talos deletes the items whose first property has the same value, so set only the
      /// property to match on.
      `$patch`: patch.Directive?
    }
    
    /// MachineConfig holds machine settings.
    class MachineConfig {
      /// Accepted CAs.
      acceptedCAs: (*Listing<MachineConfigAcceptedCAs> | patch.Delete)?
    
      logging: (*Listing<LoggingDestination> | patch.Delete)?
    
      /// Set to `"delete"` to delete this object from the machine configuration.
      ///
      /// In a list, Talos deletes the items whose first property has the same value, so set only the
      /// property to match on.
      `$patch`: patch.Directive?
    }
    
    class MachineConfigAcceptedCAs {
      crt: (String | patch.Delete)?
    
      /// Set to `"delete"` to delete this object from the machine configuration.
      ///
      /// In a list, Talos deletes the items whose first property has the same value, so set only the
      /// property to match on.
      `$patch`: patch.Directive?
    }
    
    """
  }
  ["version module"] {
    """
    // Code generated by pkl-talos from the Talos v0.0.1 machine configuration schema. DO NOT EDIT.
    
    /// The Talos release that this package was generated from.
    module talos.version
    
    /// Talos version, without the `v` prefix.
    fixed talos: String = "0.0.1"
    
    /// The machine configuration schema that this package was generated from.
    fixed schemaUrl: String = "https://example.com/config.schema.json"
    
    """
  }
}
