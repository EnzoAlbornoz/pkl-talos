{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talos.dev/v0.0/schemas/config.schema.json",
  "$defs": {
    "example.GadgetConfigV1Alpha1": {
      "properties": {
        "apiVersion": { "enum": ["v1alpha1"], "title": "apiVersion" },
        "kind": { "enum": ["GadgetConfig"], "title": "kind" },
        "mode": {
          "enum": ["on", "off"],
          "title": "mode",
          "markdownDescription": "Whether the gadget runs."
        },
        "timeout": {
          "type": "string",
          "pattern": "^[-+]?(((\\d+(\\.\\d*)?|\\d*(\\.\\d+)+)([nuµm]?s|m|h))|0)+$",
          "title": "timeout"
        },
        "manifest": { "type": "object", "title": "manifest" }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["apiVersion", "kind"],
      "description": "GadgetConfig configures the gadget."
    },
    "example.WidgetConfigV1Alpha1": {
      "properties": {
        "apiVersion": { "enum": ["v1alpha1"], "title": "apiVersion" },
        "kind": { "enum": ["WidgetConfig"], "title": "kind" },
        "name": {
          "type": "string",
          "title": "name",
          "markdownDescription": "Name of the widget."
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 10, "title": "size" },
        "local": { "type": "boolean", "title": "local" },
        "tcp-data-split": { "type": "string", "title": "tcp-data-split" },
        "parts": {
          "items": { "$ref": "#/$defs/example.Part" },
          "type": "array",
          "minItems": 1,
          "title": "parts"
        },
        "labels": {
          "patternProperties": { ".*": { "type": "string" } },
          "type": "object",
          "title": "labels"
        },
        "args": {
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "items": { "type": "string" }, "type": "array" }]
          },
          "type": "object",
          "title": "args"
        },
        "ports": {
          "items": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
          "type": "array",
          "title": "ports"
        },
        "tls": {
          "properties": {
            "crt": { "type": "string", "title": "crt" },
            "key": { "type": "string", "title": "key" }
          },
          "additionalProperties": false,
          "type": "object",
          "title": "tls",
          "markdownDescription": "The widget's certificate and key."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["apiVersion", "kind", "name"],
      "description": "WidgetConfig configures a widget.\n\nIt has many parts."
    },
    "example.Part": {
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^[0-9a-f.:]+/\\d{1,3}$",
          "title": "address",
          "markdownDescription": "Address of the part."
        },
        "priority": { "type": "integer", "title": "priority" }
      },
      "additionalProperties": false,
      "type": "object",
      "required": ["address"],
      "description": "Part is a part of a widget."
    },
    "example.Unused": {
      "properties": { "x": { "type": "string" } },
      "additionalProperties": false,
      "type": "object"
    },
    "v1alpha1.Config": {
      "properties": {
        "version": { "enum": ["v1alpha1"], "title": "version" },
        "machine": { "$ref": "#/$defs/v1alpha1.MachineConfig", "title": "machine" }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Config is the legacy document."
    },
    "v1alpha1.MachineConfig": {
      "properties": {
        "acceptedCAs": {
          "properties": { "crt": { "type": "string", "title": "crt" } },
          "additionalProperties": false,
          "type": "object",
          "title": "acceptedCAs",
          "markdownDescription": "Accepted CAs."
        },
        "logging": {
          "items": { "$ref": "#/$defs/v1alpha1.LoggingDestination" },
          "type": "array",
          "title": "logging"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "MachineConfig holds machine settings."
    },
    "v1alpha1.LoggingDestination": {
      "properties": {
        "endpoint": { "$ref": "#/$defs/v1alpha1.Endpoint", "title": "endpoint" }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "v1alpha1.Endpoint": {
      "properties": {},
      "additionalProperties": false,
      "type": "object",
      "description": "Endpoint represents the endpoint URL parsed out of the machine config."
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/example.GadgetConfigV1Alpha1" },
    { "$ref": "#/$defs/example.WidgetConfigV1Alpha1" },
    { "$ref": "#/$defs/v1alpha1.Config" }
  ]
}
