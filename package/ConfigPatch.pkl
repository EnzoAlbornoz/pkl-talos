/// A Talos machine configuration patch: documents that `talosctl` merges into a machine configuration.
///
/// ```
/// amends "@talos/ConfigPatch.pkl"
///
/// import "@talos/network/LinkConfig.pkl"
/// import "@talos/patch.pkl"
/// import "@talos/v1alpha1/Config.pkl"
///
/// documents {
///   new Config {
///     machine {
///       certSANs { "k8s.example.com" }
///     }
///   }
///   new LinkConfig {
///     name = "eth0"
///     mtu = 9000
///     routes = patch.deleted
///   }
/// }
/// ```
///
/// `pkl eval patch.pkl` renders the documents as a multi-document YAML stream, for
/// `talosctl machineconfig patch --patch @patch.yaml`, `talosctl patch machineconfig` or
/// `talosctl gen config --config-patch`.
///
/// Patches are partial: every property is optional, and any property can be set to `patch.deleted`.
/// Before rendering, this module checks the rules of `$patch: delete` that Talos applies (see
/// `patch.pkl`), and fails with a list of the problems it finds.
open module talos.ConfigPatch

import "Document.pkl"
import "internal/validation.pkl"
import "schema.pkl"

/// The documents of the patch, in the order Talos applies them.
///
/// A [Dynamic] document is rendered as it is, without checks. Use one for settings that the typed
/// documents do not describe.
documents: Listing<Document | *Dynamic>

output {
  value = validation.checked(documents, validation.patchRules)
  renderer = new YamlRenderer {
    isStream = true
    converters = schema.converters
  }
}
